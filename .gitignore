# ==========================================
# 1. R / RStudio specific files
# ==========================================
# History and workspace state files (changes constantly, no need to track)
.Rhistory
.Rapp.history
.RData
.Ruserdata

# RStudio user-specific settings directory
.Rproj.user/

# ==========================================
# 2. Project-specific output files
# ==========================================
# Exclude results generated by the simulation
# (These can be regenerated by running the code, so we exclude them to save repository space)
output/tables/*.csv
output/plots/*.png

# ==========================================
# 3. OS / Editor hidden files
# ==========================================
# Mac
.DS_Store

# Windows
Thumbs.db

# VSCode (if you are using it)
.vscode/